# ==============================================================================
# Padrinho Track — Arquivo de Exemplo de Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Autenticação e Segurança (Obrigatórios)
# ------------------------------------------------------------------------------
# Usuário e senha para acesso ao painel de coordenação
APP_USERNAME=admin
APP_PASSWORD=altere_esta_senha_em_producao

# Chave secreta usada pelo Flask para assinar cookies de sessão
# Em produção, gere uma chave forte, por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-mude-em-producao-1234567890

# ------------------------------------------------------------------------------
# Banco de Dados (Opcional)
# ------------------------------------------------------------------------------
# Por padrão, se DATABASE_URL estiver vazio, a aplicação utiliza SQLite local em instance/mentoria.db
# Para usar PostgreSQL (ex: Railway, Supabase, Neon):
# DATABASE_URL=postgresql://usuario:senha@host:5432/padrinho_track

# ------------------------------------------------------------------------------
# Servidor e Execução (Opcional)
# ------------------------------------------------------------------------------
# Porta de execução local (padrão: 5000)
PORT=5000
FLASK_ENV=development

# ------------------------------------------------------------------------------
# Integrações de IA (Opcional)
# ------------------------------------------------------------------------------
# Chave de API Google Gemini (para recursos assistidos de IA)
GEMINI_API_KEY=
